# Application
APP_NAME=dedup-service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
MAX_UPLOAD_SIZE=10485760

# CORS
CORS_ORIGINS=*

# SQL Server Database Settings
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=enrollment_db
DB_USERNAME=sa
DB_PASSWORD=YourPassword123
DB_DRIVER=pymssql
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Milvus (Shared with enrollment service)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=devuser
MILVUS_PASSWORD=admin12345
MILVUS_COLLECTION=enrollment_embeddings
MILVUS_SEARCH_TIMEOUT=10.0
MILVUS_INSIGHTFACE_INDEX_TYPE=HNSW
MILVUS_INSIGHTFACE_METRIC_TYPE=IP
MILVUS_INSIGHTFACE_HNSW_M=16
MILVUS_INSIGHTFACE_HNSW_EF_CONSTRUCTION=200

# Face Recognition Settings

# Provider: InsightFace only
FACE_RECOGNITION_PROVIDER=insightface

# Common settings
FACE_DETECTION_THRESHOLD=0.6
IMAGE_MAX_SIZE=1920
ALLOW_MULTIPLE_FACES=false
IMAGE_FORMATS=JPEG,JPG,PNG
IMAGE_EXTENSIONS=.jpg,.jpeg,.png

# Face 1:1 Comparison
FACE_COMPARE_THRESHOLD=0.4

# Search Defaults
DEFAULT_TOP_K=10
DEFAULT_THRESHOLD=0.85
MAX_TOP_K=100

# Fraud Detection Scheduler
FRAUD_DETECTOR_ENABLED=true
FRAUD_DETECTOR_INTERVAL_SECONDS=20
FRAUD_DETECTOR_BATCH_SIZE=1000
FRAUD_DETECTOR_THRESHOLD=0.7
FRAUD_DETECTOR_TOP_K=5
